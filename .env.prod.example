# ──────────────────────────────────────────────
# ALLFOLIO production/self-hosted environment
# Copy to `.env.prod` and fill values.
# Never commit real `.env.prod`.
# ──────────────────────────────────────────────

POSTGRES_PASSWORD=change_me_strong_password
ALLFOLIO_JWT_SECRET=change_me_32_plus_byte_secret
ALLFOLIO_ENCRYPTION_KEY=base64_32_byte_key_from_openssl_rand_base64_32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=https://allfolio-app.vercel.app

# Docker 이미지 태그
# GitHub Actions 자동 배포 시: ghcr.io/hong9/allfolio-backend:latest
# 서버에서 직접 빌드 시: allfolio-backend:latest
DOCKER_IMAGE_BACKEND=ghcr.io/kanghonggu/allfolio-backend:latest

# 도메인 설정
DOMAIN=allfolio.me
FRONTEND_DOMAIN=allfolio-app.vercel.app

# Grafana 관리자 비밀번호
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# 금융위원회 FSC API 키 (data.go.kr 발급)
# KRX 전체 상장종목 목록 자동 갱신 + 한국 주식 실시간 시세 조회에 사용
# 미설정 시 해당 기능 비활성화 (Yahoo Finance fallback)
FSC_API_KEY=

MORALIS_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
SAMSUNG_APP_KEY=
SAMSUNG_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
