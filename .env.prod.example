# ──────────────────────────────────────────────
# ALLFOLIO 프로덕션 환경 변수
# cp .env.prod.example .env.prod 후 값 채우기
# .env.prod 는 절대 git commit 하지 말 것!
# ──────────────────────────────────────────────

# DB 비밀번호 (강력한 패스워드로 변경)
POSTGRES_PASSWORD=change_me_strong_password

# Keycloak 관리자 비밀번호
KEYCLOAK_ADMIN_PASSWORD=change_me_admin_password

# Keycloak 외부 호스트명
KEYCLOAK_HOSTNAME=auth.allfolio.me

# Docker 이미지 태그
# GitHub Actions 자동 배포 시: ghcr.io/hong9/allfolio-backend:latest
# 서버에서 직접 빌드 시: allfolio-backend:latest
DOCKER_IMAGE_BACKEND=ghcr.io/kanghonggu/allfolio-backend:latest

# 도메인 설정
DOMAIN=allfolio.me
FRONTEND_DOMAIN=allfolio-app.vercel.app

# Grafana 관리자 비밀번호
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
