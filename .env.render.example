# ──────────────────────────────────────────────
# Render dashboard environment template
# Do not commit a real `.env.render`.
# Paste these keys into Render > Web Service > Environment.
# ──────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

# Neon Postgres
DB_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_USER=USER
DB_PASS=PASSWORD

# Auth
ALLFOLIO_JWT_SECRET=change_me_32_plus_byte_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Vercel/custom frontend origin
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app

# Keep free Render deployment light
KAFKA_ENABLED=false

# Optional integrations
FSC_API_KEY=
MORALIS_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
SAMSUNG_APP_KEY=
SAMSUNG_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
