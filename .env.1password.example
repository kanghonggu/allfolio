# 1Password secret reference template for GitHub Actions.
# Copy the item/field paths to match your 1Password vault.
# Do not put real secret values in this file.

# GitHub Actions uses this to authenticate to the Render API.
RENDER_API_KEY=op://allfolio-prod/render/api-key
RENDER_SERVICE_ID=op://allfolio-prod/render/backend-service-id

# Values synced into the Render backend service environment.
SPRING_PROFILES_ACTIVE=prod
DB_URL=op://allfolio-prod/neon/jdbc-url
DB_USER=op://allfolio-prod/neon/user
DB_PASS=op://allfolio-prod/neon/password
ALLFOLIO_JWT_SECRET=op://allfolio-prod/allfolio/jwt-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=op://allfolio-prod/vercel/allowed-origins
KAFKA_ENABLED=false

# Optional integrations. Uncomment a key here and add the same mapping to
# `.github/workflows/sync-render-env.yml` only when you actually use it.
# FSC_API_KEY=op://allfolio-prod/integrations/fsc-api-key
# MORALIS_API_KEY=op://allfolio-prod/integrations/moralis-api-key
# BINANCE_API_KEY=op://allfolio-prod/integrations/binance-api-key
# BINANCE_API_SECRET=op://allfolio-prod/integrations/binance-api-secret
# KIS_APP_KEY=op://allfolio-prod/integrations/kis-app-key
# KIS_APP_SECRET=op://allfolio-prod/integrations/kis-app-secret
# KIWOOM_APP_KEY=op://allfolio-prod/integrations/kiwoom-app-key
# KIWOOM_APP_SECRET=op://allfolio-prod/integrations/kiwoom-app-secret
# SAMSUNG_APP_KEY=op://allfolio-prod/integrations/samsung-app-key
# SAMSUNG_APP_SECRET=op://allfolio-prod/integrations/samsung-app-secret
# TOSS_CLIENT_ID=op://allfolio-prod/integrations/toss-client-id
# TOSS_CLIENT_SECRET=op://allfolio-prod/integrations/toss-client-secret
