# ──────────────────────────────────────────────
# ALLFOLIO local/backend environment
# Copy to `.env` for docker compose, or `.env.local` if you run with:
# docker compose --env-file .env.local up -d
#
# Never commit real `.env` / `.env.*` files.
# ──────────────────────────────────────────────

# Local Docker Postgres
POSTGRES_PASSWORD=postgres

# Backend DB
DB_URL=jdbc:postgresql://localhost:5432/allfolio?reWriteBatchedInserts=true&prepareThreshold=5
DB_USER=postgres
DB_PASS=postgres

# Auth
ALLFOLIO_JWT_SECRET=dev-only-change-me-dev-only-change-me
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
ACCESS_TOKEN_MINUTES=15
AUTH_COOKIE_SECURE=false
REFRESH_TOKEN_DAYS=30
ALLOWED_ORIGINS=http://localhost:3000

# Optional infra
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional market/broker integrations
FSC_API_KEY=
MORALIS_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
SAMSUNG_APP_KEY=
SAMSUNG_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
